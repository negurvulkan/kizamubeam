{
  "name": "kizamubeam",
  "version": "1.0.0-alpha",
  "description": "Freie Laser-Software, angelehnt an die Bedienung von LightBurn (Prototyp)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:core": "node scripts/core-fixtures.mjs && cd src-tauri && cargo test -p kizamubeam-core",
    "test:gcode": "node scripts/run-ts.mjs scripts/gcode-test.ts",
    "test:paths": "node scripts/run-ts.mjs scripts/pathtools-test.ts",
    "test:vartext": "node scripts/run-ts.mjs scripts/vartext-test.ts",
    "test:history": "node scripts/run-ts.mjs scripts/history-test.ts",
    "test:joints": "node scripts/run-ts.mjs scripts/joints-test.ts",
    "test:generators": "node scripts/run-ts.mjs scripts/generators-test.ts",
    "test:3d": "node scripts/run-ts.mjs scripts/view3d-test.ts"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/clipper-lib": "^6.4.0",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.180.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "clipper-lib": "^6.4.2",
    "opentype.js": "^1.3.4",
    "qrcode-generator": "^2.0.4",
    "three": "^0.180.0",
    "utif": "^3.1.0"
  },
  "private": true,
  "type": "module"
}
